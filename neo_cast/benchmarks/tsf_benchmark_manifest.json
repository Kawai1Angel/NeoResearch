      "primary_metric": "mse",
      "reference_metrics": ["mse", "mae"],
      "requires_external_data_file": true,
      "expected_data_files": ["traffic.csv"],
      "notes": "Uses contiguous 70/10/20 train/validation/reference-test rows; numeric features are inferred."
