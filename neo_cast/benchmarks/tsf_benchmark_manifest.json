      "default_horizons": [96, 192, 336, 720],
      "primary_metric": "mse",
      "reference_metrics": ["mse", "mae"],
      "requires_external_data_file": true,
      "expected_data_files": ["ETTm1.csv"],
      "notes": "Uses the canonical TSLib 15-minute ETT split encoded in the dataset preset."
    },
    "weather": {
      "dataset_id": "weather",
