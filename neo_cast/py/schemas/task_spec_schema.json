{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustc-time-series.github.io/neo-cast/schemas/task_spec_schema.json",
  "title": "neo-cast Task Spec Schema",
  "description": "Structured research task contract produced after intent scoping and consumed by downstream NeoResearch agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "target_column",
    "time_column",
    "frequency",
    "history_window",
    "prediction_horizon",
    "prediction_horizons",
    "metrics",
    "constraints",
    "output",
    "interaction_mode"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "task_spec.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "task_type": {
      "type": "string",
      "enum": ["time_series_forecasting"]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "target_column": {
      "type": "string",
      "minLength": 1
    },
    "time_column": {
      "type": "string",
      "minLength": 1
    },
    "frequency": {
      "type": "string",
      "minLength": 1
    },
    "history_window": {
      "type": "integer",
      "minimum": 1
    },
    "prediction_horizon": {
      "type": "integer",
      "minimum": 1
    },
    "prediction_horizons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_model_params": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "max_training_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prefer_lightweight_model": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report",
        "model_code",
        "checkpoint",
        "inference_api"
      ],
      "properties": {
        "report": {
          "type": "boolean"
        },
        "model_code": {
          "type": "boolean"
        },
        "checkpoint": {
          "type": "boolean"
        },
        "inference_api": {
          "type": "boolean"
        }
      }
    },
    "interaction_mode": {
      "type": "string",
      "enum": ["socratic", "cognitive_copilot"]
    }
  }
}
