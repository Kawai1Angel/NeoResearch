{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustc-time-series.github.io/neo-cast/schemas/metadata_schema.json",
  "title": "neo-cast Metadata Schema",
  "description": "Artifact metadata contract for exported neo-cast runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "run_id",
    "task_id",
    "model_family",
    "model_impl_entry",
    "state_dict_layout",
    "input_len",
    "horizons",
    "num_channels",
    "normalization_space",
    "feature_names",
    "preprocess_entry",
    "val_metrics",
    "files",
    "created_at"
  ],
  "properties": {
    "artifact_version": {
      "type": "string",
      "const": "artifact.v1"
    },
    "dataset_schema_version": {
      "type": "string",
      "enum": [
        "dataset.v1",
        "dataset.v2"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[a-zA-Z0-9]{4,16}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "model_family": {
      "type": "string",
      "enum": [
        "nlinear",
        "recipe_factory",
        "tiny_transformer",
        "patch_mlp"
      ]
    },
    "model_impl_entry": {
      "type": "string",
      "pattern": "^[^:]+:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "state_dict_layout": {
      "type": "string",
      "enum": [
        "single_model",
        "per_horizon",
        "shared_backbone"
      ]
    },
    "input_len": {
      "type": "integer",
      "minimum": 1
    },
    "horizons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "num_channels": {
      "type": "integer",
      "minimum": 1
    },
    "normalization_space": {
      "type": "string",
      "enum": [
        "standard_scaled"
      ]
    },
    "feature_names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "used_observed_past_covariates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "used_known_future_covariates": {
      "type": "array",
      "maxItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "target_channels": {
      "type": "integer",
      "minimum": 1
    },
    "past_exogenous_channels": {
      "type": "integer",
      "minimum": 0
    },
    "future_exogenous_channels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "model_input_channels": {
      "type": "integer",
      "minimum": 1
    },
    "model_output_channels": {
      "type": "integer",
      "minimum": 1
    },
    "experiment_scope": {
      "type": "string",
      "minLength": 1
    },
    "production_comparable": {
      "type": "boolean"
    },
    "preprocess_entry": {
      "type": "string",
      "minLength": 1
    },
    "val_metrics": {
      "$ref": "#/$defs/valMetricsBlock"
    },
    "cv_metrics": {
      "$ref": "#/$defs/cvMetricsBlock"
    },
    "ref_test_metrics": {
      "$ref": "#/$defs/refTestMetricsBlock"
    },
    "training_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_impl_entry", "state_dict_layout"],
          "properties": {
            "model_impl_entry": {"type": "string", "minLength": 1},
            "state_dict_layout": {"type": "string", "minLength": 1}
          }
        },
        "training_seconds": {
          "type": "number",
          "minimum": 0
        },
        "total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_vram_mb": {
          "type": "number",
          "minimum": 0
        },
        "num_params_M": {
          "type": "number",
          "minimum": 0
        },
        "preprocessing_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embedding": {
          "type": "string"
        },
        "backbone": {
          "type": "string"
        },
        "fusion": {
          "type": "string"
        },
        "prediction_head": {
          "type": "string"
        },
        "output_distribution": {
          "type": "string",
          "enum": [
            "point",
            "quantile",
            "gaussian"
          ]
        },
        "training_prediction": {
          "type": "string",
          "enum": [
            "point_forecast",
            "quantile_distribution",
            "gaussian_distribution"
          ]
        },
        "loss": {
          "type": "string"
        },
        "quantiles": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        },
        "target_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used_observed_past_covariates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used_known_future_covariates": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "target_channels": {
          "type": "integer",
          "minimum": 1
        },
        "past_exogenous_channels": {
          "type": "integer",
          "minimum": 0
        },
        "future_exogenous_channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "model_input_channels": {
          "type": "integer",
          "minimum": 1
        },
        "model_output_channels": {
          "type": "integer",
          "minimum": 1
        },
        "future_covariate_mode": {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        "first_batch_shapes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "latency_ms_by_horizon": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "runtime_semantics_revision": {
          "enum": [
            2,
            3
          ]
        },
        "model_manifests": {
          "type": "object"
        },
        "model_manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementation_status": {
          "enum": [
            "native",
            "paper_derived"
          ]
        },
        "architecture_id": {
          "type": "string"
        },
        "experiment_id": {
          "type": "string"
        },
        "normalization_revision": {
          "type": "integer"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_pt",
        "preprocess_json",
        "model_impl_py",
        "inference_py",
        "eval_report_md",
        "model_spec_json",
        "patch_bundle_json",
        "research_trace_json"
      ],
      "properties": {
        "model_pt": {
          "type": "string",
          "minLength": 1
        },
        "preprocess_json": {
          "type": "string",
          "minLength": 1
        },
        "model_impl_py": {
          "type": "string",
          "minLength": 1
        },
        "inference_py": {
          "type": "string",
          "minLength": 1
        },
        "eval_report_md": {
          "type": "string",
          "minLength": 1
        },
        "model_spec_json": {
          "type": "string",
          "minLength": 1
        },
        "patch_bundle_json": {
          "type": "string",
          "minLength": 1
        },
        "research_trace_json": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_semantics_revision": {
      "enum": [
        2,
        3
      ]
    }
  },
  "$defs": {
    "cvMetricsBlock": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^cv_h[0-9]+_[a-z0-9_]+$": {
          "type": "number"
        },
        "^cv_avg_[a-z0-9_]+$": {
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "protocol",
        "cv_avg_mse",
        "cv_std_mse",
        "folds"
      ],
      "properties": {
        "schema_version": {
          "const": "cv_metrics.v1"
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "protocol_id",
            "num_folds",
            "initial_train_ratio",
            "visible_rows",
            "input_len",
            "horizons"
          ],
          "properties": {
            "runtime_semantics_revision": {
              "enum": [
                2,
                3
              ]
            },
            "strategy": {
              "const": "expanding_window_ratio"
            },
            "protocol_id": {
              "type": "string",
              "minLength": 1
            },
            "num_folds": {
              "type": "integer",
              "minimum": 2
            },
            "initial_train_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "fold_val_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "visible_rows": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "input_len": {
              "type": "integer",
              "minimum": 1
            },
            "horizons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "min_train_windows": {
              "type": "integer",
              "minimum": 1
            },
            "min_eval_windows": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "cv_avg_mse": {
          "type": "number"
        },
        "cv_std_mse": {
          "type": "number",
          "minimum": 0
        },
        "cv_avg_mae": {
          "type": "number"
        },
        "folds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^val_h[0-9]+_[a-z0-9_]+$": {
                "type": "number"
              },
              "^val_avg_[a-z0-9_]+$": {
                "type": "number"
              }
            },
            "required": [
              "fold_index",
              "train_rows",
              "val_rows",
              "val_avg_mse"
            ],
            "properties": {
              "fold_index": {
                "type": "integer",
                "minimum": 0
              },
              "train_rows": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "val_rows": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "val_avg_mse": {
                "type": "number"
              },
              "val_avg_mae": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "valMetricsBlock": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "required": [
        "val_avg_mse"
      ],
      "properties": {
        "val_avg_mse": {
          "type": "number"
        },
        "val_avg_mae": {
          "type": "number"
        }
      }
    },
    "refTestMetricsBlock": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "required": [
        "ref_test_avg_mse"
      ],
      "properties": {
        "ref_test_avg_mse": {
          "type": "number"
        },
        "ref_test_avg_mae": {
          "type": "number"
        }
      }
    }
  }
}
