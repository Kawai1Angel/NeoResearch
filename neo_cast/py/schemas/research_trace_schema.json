{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/neo-cast/schemas/research_trace_schema.json",
  "title": "neo-cast Research Trace Schema",
  "description": "Auditable record of why NeoResearch made each key research decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "candidate_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "research_trace.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/traceEntry"
      }
    }
  },
  "$defs": {
    "traceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_id",
        "stage",
        "decision",
        "made_by",
        "candidate_id",
        "run_id",
        "task_id",
        "evidence",
        "expected_effect",
        "verification_plan",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "research_trace_entry.v1"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "intent_scope",
            "literature_search",
            "data_diagnosis",
            "hypothesis_planning",
            "model_design",
            "model_compile",
            "train_eval",
            "reflection",
            "result_publish"
          ]
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "made_by": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1
        },
        "verification_plan": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
