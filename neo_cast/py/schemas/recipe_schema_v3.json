            "n_layers",
            "dropout"
          ],
          "properties": {
            "type": {
              "const": "nbeats"
            },
            "hidden_dim": {
              "type": "integer",
              "minimum": 8,
              "maximum": 4096
            },
            "n_blocks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "n_layers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "activation": {
              "type": "string",
