            },
            "attention": {
              "type": "string",
              "enum": [
                "none",
                "lightweight",
                "full"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "hidden_dim",
            "n_layers",
            "top_k",
            "kernel_size",
            "dropout"
          ],
          "properties": {
            "type": {
              "const": "timesnet_lite"
            },
            "hidden_dim": {
              "type": "integer",
              "minimum": 8,
              "maximum": 4096
            },
            "n_layers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "kernel_size": {
              "type": "integer",
              "minimum": 2,
              "maximum": 255
            },
            "dropout": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.9
            },
            "attention": {
              "type": "string",
              "enum": [
                "none",
