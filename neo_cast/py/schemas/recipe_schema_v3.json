        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "d_model",
            "state_dim",
            "depth",
            "dropout"
          ],
          "properties": {
            "type": {
              "const": "diagonal_ssm"
            },
            "d_model": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "state_dim": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "dropout": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "d_model",
            "d_ff",
            "depth",
            "top_k",
            "num_kernels",
            "dropout"
          ],
          "properties": {
            "type": {
              "const": "timesblock_encoder"
            },
            "d_model": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "d_ff": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "depth": {
