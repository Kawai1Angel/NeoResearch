{
  "recipe_version": "recipe_schema_v3",
  "recipe_id": "recipe_dlinear_original_direct_example",
  "hypothesis": "Original DLinear directly sums moving-average trend and residual Linear(context,H) forecasts without a learned latent-to-horizon head.",
  "preprocessing": {
    "actions": [
      {
        "type": "none"
      }
    ]
  },
  "embedding": {
    "type": "none"
  },
  "backbone": {
    "type": "dlinear",
    "kernel_size": 25,
    "bias": true,
    "individual": false
  },
  "fusion": {
    "type": "temporal",
    "channel_mode": "independent"
  },
  "prediction_head": {
    "type": "identity",
    "output_distribution": "point"
  },
  "post_processing": {
    "type": "auto"
  },
  "training_strategy": {
    "loss": {
      "base": "mse",
      "horizon_weighting": "uniform"
    },
    "optimizer": {
      "type": "adam",
      "lr": 0.001,
      "weight_decay": 0.0
    },
    "scheduler": {
      "type": "none",
      "warmup_steps": 0
    },
    "regularization": {
      "grad_clip": 1.0
    },
    "budget": {
      "max_epochs": 2,
      "time_budget_s": 120,
      "batch_size": 16,
      "patience": 2,
      "seed": 42
    }
  },
  "constraints": {
    "max_params": 1000000,
    "max_latency_ms": 50,
    "latency_priority": "medium"
  },
  "notes": "Use forecast horizon 24. kernel_size=25, shared seasonal/trend projections with bias and default nn.Linear initialization. No additional normalization/centering/embedding; dataset training-only StandardScaler is retained. Reference: https://github.com/cure-lab/LTSF-Linear/blob/main/models/DLinear.py",
  "representation": {
    "layout": "channel_latent",
    "readout": "none",
    "latent_dim": 24
  },
  "composition": {
    "type": "single"
  }
}
