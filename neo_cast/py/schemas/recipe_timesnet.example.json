{
  "recipe_version": "recipe_schema_v1",
  "recipe_id": "recipe_timesnet_example",
  "hypothesis": "TimesNet-lite uses FFT-derived period grids and compact 2D convolutions, testing periodic structure without allowing arbitrary model code.",
  "preprocessing": {
    "actions": [
      {
        "type": "instance_norm",
        "affine": false,
        "eps": 0.00001
      }
    ]
  },
  "embedding": {
    "type": "none"
  },
  "backbone": {
    "type": "timesnet",
    "hidden_dim": 16,
    "n_layers": 1,
    "top_k": 1,
    "kernel_size": 3,
    "dropout": 0.1
  },
  "fusion": {
    "type": "temporal",
    "channel_mode": "independent"
  },
  "prediction_head": {
    "type": "linear",
    "output_distribution": "point",
    "share_across_horizons": false
  },
  "post_processing": {
    "type": "auto"
  },
  "training_strategy": {
    "loss": {
      "base": "mse",
      "horizon_weighting": "uniform"
    },
    "optimizer": {
      "type": "adamw",
      "lr": 0.001,
      "weight_decay": 0.0001
    },
    "scheduler": {
      "type": "none",
      "warmup_steps": 0
    },
    "regularization": {
      "dropout": 0.1,
      "grad_clip": 1.0
    },
    "budget": {
      "max_epochs": 2,
      "time_budget_s": 120,
      "batch_size": 16,
      "patience": 2,
      "seed": 42
    }
  },
  "constraints": {
    "max_params": 1000000,
    "max_latency_ms": 80,
    "latency_priority": "medium"
  },
  "notes": "TimesNet-lite requires embedding.type=none in the current recipe factory."
}
