{
  "recipe_version": "recipe_schema_v2",
  "recipe_id": "recipe_patch_tcn_example",
  "hypothesis": "Encode single-scale per-channel Patch tokens with tcn, preserving all token positions in the flatten readout.",
  "preprocessing": {
    "actions": [
      {
        "type": "instance_norm",
        "affine": false,
        "eps": 1e-05
      }
    ]
  },
  "embedding": {
    "type": "patch",
    "patch_len": 8,
    "stride": 4,
    "d_model": 16
  },
  "backbone": {
    "type": "tcn",
    "hidden_dim": 16,
    "n_layers": 1,
    "kernel_size": 3,
    "activation": "gelu",
    "dropout": 0.1
  },
  "fusion": {
    "type": "temporal",
    "channel_mode": "independent"
  },
  "prediction_head": {
    "type": "linear",
    "output_distribution": "point"
  },
  "post_processing": {
    "type": "auto"
  },
  "training_strategy": {
    "loss": {
      "base": "mse",
      "horizon_weighting": "uniform"
    },
    "optimizer": {
      "type": "adamw",
      "lr": 0.001,
      "weight_decay": 0.0001
    },
    "scheduler": {
      "type": "none",
      "warmup_steps": 0
    },
    "regularization": {
      "grad_clip": 1.0
    },
    "budget": {
      "max_epochs": 2,
      "time_budget_s": 120,
      "batch_size": 16,
      "patience": 2,
      "seed": 42
    }
  },
  "constraints": {
    "max_params": 1000000,
    "max_latency_ms": 80,
    "latency_priority": "medium"
  },
  "notes": "unfold without tail padding; feature-major/token-position flatten readout to latent, then the original head. Requires fresh training."
}
