{
  "recipe_version": "recipe_schema_v1",
  "recipe_id": "recipe_multiscale_patch_mlp_example",
  "hypothesis": "Multi-scale patches can expose both short-cycle and longer local temporal motifs before a compact MLP backbone.",
  "preprocessing": {
    "actions": [
      {
        "type": "instance_norm",
        "affine": false,
        "eps": 0.00001
      }
    ]
  },
  "embedding": {
    "type": "multiscale_patch",
    "scales": [
      {
        "patch_len": 8,
        "stride": 4
      },
      {
        "patch_len": 16,
        "stride": 8
      },
      {
        "patch_len": 32,
        "stride": 16
      }
    ],
    "d_model": 64
  },
  "backbone": {
    "type": "mlp",
    "depth": 2,
    "hidden_dim": 64,
    "activation": "gelu",
    "dropout": 0.1
  },
  "fusion": {
    "type": "temporal",
    "channel_mode": "shared"
  },
  "prediction_head": {
    "type": "linear",
    "output_distribution": "point",
    "share_across_horizons": false
  },
  "post_processing": {
    "type": "auto"
  },
  "training_strategy": {
    "loss": {
      "base": "mse",
      "horizon_weighting": "uniform"
    },
    "optimizer": {
      "type": "adamw",
      "lr": 0.001,
      "weight_decay": 0.0001
    },
    "scheduler": {
      "type": "none",
      "warmup_steps": 0
    },
    "regularization": {
      "dropout": 0.1,
      "grad_clip": 1.0
    },
    "budget": {
      "max_epochs": 2,
      "time_budget_s": 120,
      "batch_size": 16,
      "patience": 2,
      "seed": 42
    }
  },
  "constraints": {
    "max_params": 1000000,
    "max_latency_ms": 100,
    "latency_priority": "medium"
  },
  "notes": "Native factory example with multi-scale patch embedding and shared channel mixing."
}
