{
  "recipe_version": "recipe_schema_v1",
  "recipe_id": "recipe_native_patch_transformer_example",
  "hypothesis": "Instance-normalized patch Transformer can test a larger native recipe action space while staying inside the smoke budget.",
  "preprocessing": {
    "actions": [
      {
        "type": "instance_norm",
        "affine": false,
        "eps": 0.00001
      }
    ]
  },
  "embedding": {
    "type": "patch",
    "patch_len": 16,
    "stride": 16,
    "d_model": 32
  },
  "backbone": {
    "type": "transformer",
    "d_model": 32,
    "n_heads": 4,
    "n_layers": 1,
    "dropout": 0.1,
    "ffn_mult": 2.0
  },
  "fusion": {
    "type": "temporal",
    "channel_mode": "independent"
  },
  "prediction_head": {
    "type": "linear",
    "output_distribution": "point",
    "share_across_horizons": false
  },
  "post_processing": {
    "type": "auto"
  },
  "training_strategy": {
    "loss": {
      "base": "mae",
      "horizon_weighting": "uniform"
    },
    "optimizer": {
      "type": "adamw",
      "lr": 0.001,
      "weight_decay": 0.0001
    },
    "scheduler": {
      "type": "cosine",
      "warmup_steps": 0
    },
    "regularization": {
      "dropout": 0.1,
      "grad_clip": 1.0
    },
    "budget": {
      "max_epochs": 2,
      "time_budget_s": 120,
      "batch_size": 16,
      "patience": 2,
      "seed": 42
    }
  },
  "constraints": {
    "max_params": 1000000,
    "max_latency_ms": 80,
    "latency_priority": "medium"
  },
  "notes": "Native factory example; not bridge-compatible."
}
