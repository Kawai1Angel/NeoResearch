# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required for LLM-backed design (skip with --mock-llm for local testing)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# NEO_TSF_DATA_ROOT=~/.cache/neo_research_tsf

# Dev/test flags
# NEO_CAST_MOCK_LLM=1       # force heuristic candidate, no API call
# NEO_CAST_FAST_E2E=1       # shrink epochs/batch for fast e2e runs
