{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge_card.schema.json",
  "title": "Atomic literature knowledge card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cardID", "revision", "paperID", "cardType", "claim", "normalizedClaim", "applicability", "notApplicableWhen", "evidence", "limitations", "confidence", "status", "tags", "provenance"],
  "properties": {
    "schemaVersion": {"const": "knowledge_card_v1"},
    "cardID": {"type": "string", "pattern": "^kc_[a-f0-9]{12}$"},
    "revision": {"type": "integer", "minimum": 1},
    "paperID": {"type": "string", "minLength": 1},
    "cardType": {"enum": ["model_mechanism", "empirical_finding", "applicability_rule", "limitation", "evaluation_protocol", "domain_prior", "implementation_hint"]},
    "claim": {"type": "string", "minLength": 8, "maxLength": 2000},
    "normalizedClaim": {
      "type": "object", "additionalProperties": false, "required": ["subject", "predicate", "object"],
      "properties": {"subject": {"type": "string", "minLength": 1}, "predicate": {"type": "string", "minLength": 1}, "object": {"type": "string", "minLength": 1}}
    },
    "problem": {"type": "string"},
    "mechanism": {
      "type": "object", "additionalProperties": false, "required": ["mechanismID", "name", "principle", "components"],
      "properties": {
        "mechanismID": {"type": "string"}, "name": {"type": "string"}, "principle": {"type": "string"},
        "components": {"type": "array", "items": {"type": "string"}}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["taskTypes", "dataFeatures", "domains", "dataScale", "horizonProfile", "computeProfile", "basis"],
      "properties": {
        "taskTypes": {"type": "array", "items": {"type": "string"}}, "dataFeatures": {"type": "array", "items": {"type": "string"}},
        "domains": {"type": "array", "items": {"type": "string"}}, "dataScale": {"type": "array", "items": {"type": "string"}},
        "horizonProfile": {"type": "array", "items": {"type": "string"}}, "computeProfile": {"type": "array", "items": {"type": "string"}},
        "basis": {"enum": ["author_statement", "author_experiment", "agent_inference", "unknown"]}
      }
    },
    "notApplicableWhen": {"type": "array", "items": {"type": "string"}},
    "experimentalContext": {
      "type": "object", "additionalProperties": false, "required": ["datasets", "baselines", "metrics", "contextLengths", "predictionLengths"],
      "properties": {
        "datasets": {"type": "array", "items": {"type": "string"}}, "baselines": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"type": "string"}}, "contextLengths": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "predictionLengths": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "reportedEffect": {
          "type": "object", "additionalProperties": false, "required": ["direction"],
          "properties": {
            "direction": {"enum": ["improved", "degraded", "mixed", "no_significant_change", "unknown"]},
            "value": {"type": "number"}, "unit": {"type": "string"}, "comparedWith": {"type": "string"}
          }
        }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceID", "evidenceType", "chunkID", "section", "pageStart", "pageEnd", "evidenceSpan", "directness", "verification"],
        "properties": {
          "evidenceID": {"type": "string", "pattern": "^ev_[a-f0-9]{8,16}$"},
          "evidenceType": {"enum": ["author_definition", "author_argument", "author_experiment", "ablation_result", "complexity_analysis", "limitation_statement", "agent_inference"]},
          "chunkID": {"type": "string"}, "section": {"type": "string"}, "pageStart": {"type": "integer", "minimum": 1},
          "pageEnd": {"type": "integer", "minimum": 1}, "evidenceSpan": {"type": "string", "minLength": 1, "maxLength": 1500},
          "tableOrFigure": {"type": "string"}, "directness": {"enum": ["direct", "indirect", "inferred"]},
          "verification": {"enum": ["exact_span", "normalized_span", "manual_required"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["recipeConcepts", "registryMappings", "estimatedComplexity", "notes"],
      "properties": {
        "recipeConcepts": {"type": "array", "items": {"type": "string"}}, "registryMappings": {"type": "array", "items": {"type": "string"}},
        "estimatedComplexity": {"enum": ["low", "medium", "high", "unknown"]}, "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceQuality", "extractionConfidence", "evidenceDirectness", "transferability"],
      "properties": {
        "sourceQuality": {"type": "number", "minimum": 0, "maximum": 1}, "extractionConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidenceDirectness": {"type": "number", "minimum": 0, "maximum": 1}, "transferability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "status": {"enum": ["extracted", "paper_backed", "corroborated", "contradicted", "inconclusive", "deprecated"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceDocumentID", "sourceDocumentSha256", "sourcePublicationStatus", "extractorModel", "extractorPromptVersion", "extractionRunID", "createdAt", "updatedAt"],
      "properties": {
        "sourceDocumentID": {"type": "string"}, "sourceDocumentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourcePublicationStatus": {"type": "string"}, "extractorModel": {"type": "string"}, "extractorPromptVersion": {"type": "string"},
        "verifierModel": {"type": "string"}, "verifierPromptVersion": {"type": "string"}, "extractionRunID": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
