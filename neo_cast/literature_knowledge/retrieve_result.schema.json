{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "retrieve_result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "retrieveRunID", "taskID", "quantitativeReportArtifactID", "transformations", "intents", "candidates", "literatureResults", "summary"],
  "properties": {
    "schemaVersion": {"const": "retrieve_result_v1"}, "retrieveRunID": {"type": "string"}, "taskID": {"type": "string"}, "quantitativeReportArtifactID": {"type": "string"},
    "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
    "intents": {"type": "array", "items": {"$ref": "#/$defs/intent"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "literatureResults": {"type": "array", "items": {"$ref": "#/$defs/literatureResult"}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["intentCount", "bm25CandidateCount", "literaturePaperCount", "paperBackedCardCount", "missingPDFCount", "failedPaperCount"], "properties": {"intentCount": {"type": "integer", "minimum": 0}, "bm25CandidateCount": {"type": "integer", "minimum": 0}, "literaturePaperCount": {"type": "integer", "minimum": 0}, "paperBackedCardCount": {"type": "integer", "minimum": 0}, "missingPDFCount": {"type": "integer", "minimum": 0}, "failedPaperCount": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "paperLanguage": {"type": "object", "additionalProperties": false, "required": ["taskTerms", "phenomenonTerms", "methodTerms", "domainTerms", "queryText"], "properties": {"taskTerms": {"$ref": "#/$defs/stringArray"}, "phenomenonTerms": {"$ref": "#/$defs/stringArray"}, "methodTerms": {"$ref": "#/$defs/stringArray"}, "domainTerms": {"$ref": "#/$defs/stringArray"}, "queryText": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "metric", "value", "interpretation"], "properties": {"path": {"type": "string", "pattern": "^\\$\\."}, "metric": {"type": "string"}, "value": {}, "interpretation": {"type": "string"}}},
    "scientific": {"type": "object", "additionalProperties": false, "required": ["conceptID", "label", "paperTerms", "confidence", "basis"], "properties": {"conceptID": {"type": "string"}, "label": {"type": "string"}, "paperTerms": {"$ref": "#/$defs/stringArray"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "basis": {"enum": ["deterministic_rule", "llm_supported"]}}},
    "method": {"type": "object", "additionalProperties": false, "required": ["conceptID", "label", "paperTerms", "rationale", "status"], "properties": {"conceptID": {"type": "string"}, "label": {"type": "string"}, "paperTerms": {"$ref": "#/$defs/stringArray"}, "rationale": {"type": "string"}, "status": {"const": "retrieval_hypothesis"}}},
    "transformation": {"type": "object", "additionalProperties": false, "required": ["transformationID", "datasetEvidence", "scientificConcepts", "modelingChallenges", "methodConcepts", "paperLanguage"], "properties": {"transformationID": {"type": "string"}, "datasetEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "scientificConcepts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scientific"}}, "modelingChallenges": {"$ref": "#/$defs/stringArray"}, "methodConcepts": {"type": "array", "items": {"$ref": "#/$defs/method"}}, "paperLanguage": {"$ref": "#/$defs/paperLanguage"}}},
    "intent": {"type": "object", "additionalProperties": false, "required": ["intentID", "question", "transformationID", "priority", "mustCover", "paperLanguageQuery"], "properties": {"intentID": {"type": "string"}, "question": {"type": "string"}, "transformationID": {"type": "string"}, "priority": {"type": "number", "minimum": 0, "maximum": 1}, "mustCover": {"type": "boolean"}, "paperLanguageQuery": {"$ref": "#/$defs/paperLanguage"}}},
    "bm25": {"type": "object", "additionalProperties": false, "required": ["rank", "score", "matchedFields", "matchedTerms"], "properties": {"rank": {"type": "integer", "minimum": 1}, "score": {"type": "number", "minimum": 0}, "matchedFields": {"$ref": "#/$defs/stringArray"}, "matchedTerms": {"$ref": "#/$defs/stringArray"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "candidateID", "paperID", "intentID", "queryText", "bm25", "evidenceLevel", "localPDF", "publicationStatus", "decision", "decisionReasons"], "properties": {"schemaVersion": {"const": "retrieval_candidate_v1"}, "candidateID": {"type": "string", "pattern": "^rc_[a-f0-9]{16}$"}, "paperID": {"type": "string"}, "intentID": {"type": "string"}, "queryText": {"type": "string"}, "bm25": {"$ref": "#/$defs/bm25"}, "evidenceLevel": {"enum": ["metadata_only", "document_available", "paper_backed"]}, "localPDF": {"type": "boolean"}, "publicationStatus": {"type": "string"}, "decision": {"enum": ["send_to_literature_agent", "retain_candidate", "domain_only", "skipped_pdf_unavailable"]}, "decisionReasons": {"$ref": "#/$defs/stringArray"}}},
    "literatureResult": {"type": "object", "additionalProperties": false, "required": ["paperID", "intentIDs", "candidateIDs", "status", "acceptedCardIDs", "rejectedCandidateCount", "warningCount"], "properties": {"paperID": {"type": "string"}, "intentIDs": {"$ref": "#/$defs/stringArray"}, "candidateIDs": {"$ref": "#/$defs/stringArray"}, "status": {"enum": ["completed", "partial", "failed", "skipped_pdf_unavailable"]}, "literatureRunID": {"type": "string"}, "acceptedCardIDs": {"$ref": "#/$defs/stringArray"}, "rejectedCandidateCount": {"type": "integer", "minimum": 0}, "warningCount": {"type": "integer", "minimum": 0}, "reviewPath": {"type": "string"}, "error": {"type": "string"}}}
  }
}
